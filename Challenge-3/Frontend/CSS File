body {
  margin: 0;
  padding: 0;
  background-color: #0f1115;
  font-family: "Courier New", monospace;
  color: #d6d6d6;
}


h1 {
  text-align: center;
  margin: 28px 0;
  font-size: 20px;
  letter-spacing: 1.5px;
  color: #e0e0e0;
}


form {
  width: 400px;
  margin: 0 auto 36px auto;
  padding: 18px;
  background-color: #14171c;
  border: 1px solid #2a2e35;
}

input, textarea {
  width: 100%;
  background-color: #14171c;
  border: 1px solid #2a2e35;
  color: #d6d6d6;
  padding: 6px;
  margin-bottom:10px;
  font-family: "Courier New", monospace;
  font-size: 13px;
  width: 386px
}

textarea {
  resize: none;
  height: 60px;
  width: 386px;
}

input::placeholder,
textarea::placeholder {
  color: #8a8a8a;
}

/* ===== BUTTON ===== */
button {
  width: 100%;
  background-color: #1c2026;
  color: #d6d6d6;
  border: 1px solid #2a2e35;
  padding: 5px;
  font-family: inherit;
  cursor: pointer;
}

button:hover {
  background-color: #262b33;
}


h2 {
  
  margin-left: 20px;
  margin-bottom: 10px;
  font-size: 15px;
  letter-spacing: 1px;
  color: #8a8a8a;
}

#confessions {

 #confessions {
  max-width: 820px;
  margin: 0 auto;        
  padding-left: 20px;     
}


.confession-card {
  padding: 8px 12px;
  margin-bottom: 14px;
  border-right: 2px solid #2a2e35;
  background-color: transparent;
}


.confession-header {
  
    text-align: center;
  display: flex;
  justify-content: space-between;
  font-size: 15px;
  color: #9a9a9a;
  margin-bottom: 4px;
}

.alias {
  color: #e0e0e0;
}


.confession-text {
  font-size: 15px;
  line-height: 1.45;
  white-space: pre-wrap;
}}
