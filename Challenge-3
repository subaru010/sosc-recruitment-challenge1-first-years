const supabaseClient = window.supabase.createClient(
  supabaseUrl,
  supabaseKey
);


const aliasInput = document.getElementById("alias");
const savedAlias = localStorage.getItem("alias");


if (savedAlias) {
  aliasInput.value = savedAlias;
  aliasInput.disabled = true; // lock alias
}


const bannedWords = ["sahyadri", "trash"];


function hasBadWords(text) {
  return bannedWords.some(word =>
    text.toLowerCase().includes(word)
  );
}


document.getElementById("confessionForm").addEventListener("submit", async (event) => {
  event.preventDefault();
  const confession = document.getElementById("confession").value.trim();
  let alias = aliasInput.value.trim();


  if (!alias) {
    alert("Alias cannot be empty.");
    return;
  }


  if (hasBadWords(confession)) {
    alert("Confession contains restricted words.");
    return;
  }


  if (!localStorage.getItem("alias")) {
    localStorage.setItem("alias", alias);
    aliasInput.disabled = true;
  }


  const { error } = await supabaseClient
    .from("confessions")
    .insert([{ alias, confession }]);


  if (error) {
    console.error("Insert error:", error);
    alert(error.message);
    return;
  }


  document.getElementById("confession").value = "";
  loadConfessions();
});


async function loadConfessions() {
  const { data, error } = await supabaseClient
    .from("confessions")
    .select("*")
    .order("created_at", { ascending: false });

  if (error) {
    console.error("Select error:", error);
    return;
  }

  const container = document.getElementById("confessions");
  container.innerHTML = "";

  data.forEach(item => {
    const time = new Date(item.created_at).toLocaleString();

    container.innerHTML += `
      <div class="confession-card">
        <div class="confession-header">
          <span class="alias">&gt; ${item.alias}</span>
          <span class="time">${time}</span>
        </div>
        <div class="confession-text">
          ${item.confession}
        </div>
      </div>
    `;
  });
}


loadConfessions();

